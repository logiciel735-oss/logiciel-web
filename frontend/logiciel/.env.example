# Copia este archivo como .env y completa los valores.
# En Vercel se configuran en: Project → Settings → Environment Variables

# Supabase → Project Settings → API (URL base, sin /rest/v1)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key

# Cloudinary → Settings → Upload → Upload presets (preset tipo "Unsigned")
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset
